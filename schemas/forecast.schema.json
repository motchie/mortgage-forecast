{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mortgage-forecast/forecast.schema.json",
  "title": "Mortgage Forecast Public Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_source",
    "presentation",
    "generated_at",
    "model_status",
    "actual",
    "loans",
    "combined",
    "scenarios",
    "sensitivity",
    "sources",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["sample", "external"] }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_trend_charts"],
      "properties": {
        "show_trend_charts": { "type": "boolean" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "model_status": { "$ref": "#/$defs/modelStatus" },
    "actual": { "$ref": "#/$defs/actual" },
    "loans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/loan" }
    },
    "combined": { "$ref": "#/$defs/combined" },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    },
    "sensitivity": {
      "type": "array",
      "items": { "$ref": "#/$defs/loanSensitivity" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "verificationStatus": {
      "enum": [
        "actual",
        "contractual",
        "official_product_rule",
        "inferred",
        "scenario",
        "unverified"
      ]
    },
    "nullableDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "nonnegativeYen": { "type": "integer", "minimum": 0 },
    "rate": { "type": "number", "minimum": 0 },
    "modelStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "golden_tests_passed",
        "validated_actual_period_start",
        "validated_actual_period_end",
        "maximum_balance_error_yen",
        "latest_actual_date",
        "latest_actual_balance",
        "calculation_engine_version",
        "unverified_rule_count"
      ],
      "properties": {
        "golden_tests_passed": { "type": "boolean" },
        "validated_actual_period_start": { "$ref": "#/$defs/nullableDate" },
        "validated_actual_period_end": { "$ref": "#/$defs/nullableDate" },
        "maximum_balance_error_yen": { "$ref": "#/$defs/nonnegativeYen" },
        "latest_actual_date": { "$ref": "#/$defs/nullableDate" },
        "latest_actual_balance": {
          "anyOf": [
            { "$ref": "#/$defs/nonnegativeYen" },
            { "type": "null" }
          ]
        },
        "calculation_engine_version": { "type": "string" },
        "unverified_rule_count": { "$ref": "#/$defs/nonnegativeYen" }
      }
    },
    "actualRow": {
      "type": "object",
      "required": [
        "loan_id", "date", "payment", "principal", "interest",
        "balance_after", "annual_rate", "verification_status", "source_ids"
      ],
      "properties": {
        "loan_id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "payment": { "$ref": "#/$defs/nonnegativeYen" },
        "principal": { "$ref": "#/$defs/nonnegativeYen" },
        "interest": { "$ref": "#/$defs/nonnegativeYen" },
        "balance_after": { "$ref": "#/$defs/nonnegativeYen" },
        "annual_rate": { "$ref": "#/$defs/rate" },
        "verification_status": { "const": "actual" },
        "source_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actual": {
      "type": "object",
      "required": ["monthly_results", "balance_series"],
      "properties": {
        "monthly_results": { "type": "array", "items": { "$ref": "#/$defs/actualRow" } },
        "balance_series": { "type": "array", "items": { "type": "object" } }
      }
    },
    "loan": {
      "type": "object",
      "required": [
        "id", "display_name", "original_principal", "disbursement_date",
        "maturity_date", "current", "repayment", "interest_calculation",
        "payment_review", "rate_model", "actual_validation"
      ],
      "properties": {
        "id": { "type": "string" },
        "display_name": { "type": "string" },
        "borrower_birth_year": { "type": "integer", "minimum": 1900 },
        "original_principal": { "$ref": "#/$defs/nonnegativeYen" },
        "disbursement_date": { "type": "string", "format": "date" },
        "maturity_date": { "type": "string", "format": "date" },
        "current": { "type": "object" },
        "repayment": { "type": "object" },
        "interest_calculation": { "type": "object" },
        "payment_review": { "type": "object" },
        "rate_model": { "type": "object" },
        "actual_validation": { "type": "object" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "severity", "scope", "message",
        "verification_status", "source_ids"
      ],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["info", "warning", "critical"] },
        "scope": {
          "type": "object",
          "required": ["loan_id", "scenario_id"],
          "properties": {
            "loan_id": { "type": "string" },
            "scenario_id": { "type": "string" }
          }
        },
        "message": { "type": "string" },
        "verification_status": { "$ref": "#/$defs/verificationStatus" },
        "source_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scenarioResult": {
      "type": "object",
      "required": [
        "scenario_id", "loan_id", "starting_date", "starting_balance",
        "next_payment_review", "maximum_monthly_payment",
        "payment_cap_trigger_count", "payment_cap_events", "unpaid_interest",
        "remaining_principal_at_maturity", "final_payment", "extra_final_payment",
        "total_interest_paid", "warnings", "confidence",
        "verification_status", "chart_data"
      ],
      "properties": {
        "scenario_id": { "type": "string" },
        "loan_id": { "type": "string" },
        "starting_date": { "type": "string", "format": "date" },
        "starting_balance": { "$ref": "#/$defs/nonnegativeYen" },
        "next_payment_review": { "type": ["object", "null"] },
        "maximum_monthly_payment": { "$ref": "#/$defs/nonnegativeYen" },
        "payment_cap_trigger_count": { "$ref": "#/$defs/nonnegativeYen" },
        "payment_cap_events": { "type": "array", "items": { "type": "object" } },
        "unpaid_interest": { "type": "object" },
        "remaining_principal_at_maturity": { "$ref": "#/$defs/nonnegativeYen" },
        "final_payment": { "$ref": "#/$defs/nonnegativeYen" },
        "extra_final_payment": { "$ref": "#/$defs/nonnegativeYen" },
        "total_interest_paid": { "$ref": "#/$defs/nonnegativeYen" },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
        "confidence": { "type": "object" },
        "verification_status": { "$ref": "#/$defs/verificationStatus" },
        "chart_data": { "type": "object" }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id", "label", "type", "description", "updated_at",
        "source", "verification_status", "results"
      ],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "enum": ["constant_loan_rate", "loan_rate_path", "short_prime_path"] },
        "description": { "type": "string" },
        "updated_at": { "type": "string", "format": "date" },
        "source": { "type": "object" },
        "verification_status": { "$ref": "#/$defs/verificationStatus" },
        "annual_rate": {
          "anyOf": [
            { "$ref": "#/$defs/rate" },
            { "type": "null" }
          ]
        },
        "rate_source": { "enum": ["loan_current"] },
        "rates": { "type": "array", "items": { "type": "object" } },
        "terminal_rate": { "type": ["number", "null"] },
        "results": { "type": "array", "items": { "$ref": "#/$defs/scenarioResult" } }
      }
    },
    "sensitivityCase": {
      "type": "object",
      "required": [
        "annual_rate", "maximum_monthly_payment", "payment_cap_trigger_count",
        "unpaid_interest_ever_occurred", "first_unpaid_interest_date",
        "unpaid_interest_resolved_date", "maximum_unpaid_interest",
        "remaining_principal_at_maturity", "remaining_unpaid_interest_at_maturity",
        "final_payment", "extra_final_payment", "total_interest_paid", "warnings"
      ],
      "properties": {
        "annual_rate": { "$ref": "#/$defs/rate" },
        "maximum_monthly_payment": { "$ref": "#/$defs/nonnegativeYen" },
        "payment_cap_trigger_count": { "$ref": "#/$defs/nonnegativeYen" },
        "unpaid_interest_ever_occurred": { "type": "boolean" },
        "first_unpaid_interest_date": { "$ref": "#/$defs/nullableDate" },
        "unpaid_interest_resolved_date": { "$ref": "#/$defs/nullableDate" },
        "maximum_unpaid_interest": { "$ref": "#/$defs/nonnegativeYen" },
        "remaining_principal_at_maturity": { "$ref": "#/$defs/nonnegativeYen" },
        "remaining_unpaid_interest_at_maturity": { "$ref": "#/$defs/nonnegativeYen" },
        "final_payment": { "$ref": "#/$defs/nonnegativeYen" },
        "extra_final_payment": { "$ref": "#/$defs/nonnegativeYen" },
        "total_interest_paid": { "$ref": "#/$defs/nonnegativeYen" },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
      }
    },
    "loanSensitivity": {
      "type": "object",
      "required": ["loan_id", "cases"],
      "properties": {
        "loan_id": { "type": "string" },
        "cases": { "type": "array", "items": { "$ref": "#/$defs/sensitivityCase" } }
      }
    },
    "combined": {
      "type": "object",
      "required": ["current_balance", "current_monthly_payment", "scenarios", "sensitivity"],
      "properties": {
        "current_balance": { "$ref": "#/$defs/nonnegativeYen" },
        "current_monthly_payment": { "$ref": "#/$defs/nonnegativeYen" },
        "scenarios": { "type": "array", "items": { "type": "object" } },
        "sensitivity": {
          "type": "array",
          "items": { "$ref": "#/$defs/sensitivityCase" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "publisher", "type", "description", "retrieved_at"],
      "properties": {
        "id": { "type": "string" },
        "publisher": { "type": "string" },
        "type": { "$ref": "#/$defs/verificationStatus" },
        "description": { "type": "string" },
        "retrieved_at": { "type": "string", "format": "date" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
